@model Soltec.Portal.Web.Models.Script.SPOS_SQLScripts

<!DOCTYPE html>

<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<title>Script</title>
</head>
<body>
	<br>
	<h4 class="blue-text lighten-3">Agregar - Script SQL</h4>
	<hr />
	<br>
	<div class="row">
		<form class="col s12" asp-action="Create">
			<div class="row">
				<div asp-validation-summary="ModelOnly"></div>

				<div class="row">
					<div class="input-field col s6">
						<i class="material-icons prefix">view_headline</i>
						<input asp-for="Nombre" type="text" class="validate">
						<label asp-for="Nombre"></label>
						<span asp-validation-for="Nombre"></span>
					</div>

					<div class="input-field col s6">
					<i class="material-icons prefix">view_headline</i>
					<input asp-for="Descripcion" type="text" class="validate">
					<label for="Descripcion">Descripción</label>
					</div>

					
				</div>

				<div class="row">
					<div class="input-field col s12">
						<i class="material-icons prefix">view_headline</i>
						<textarea asp-for="SQLScript" class="materialize-textarea" data-length="20000"></textarea>
						<label for="SQLScript">Script SQL</label>
					</div>
				</div>

				<div class="row">
					<div class="input-field col s6">
						<i class="material-icons prefix">view_headline</i>
						<input asp-for="Tipo" type="text" class="validate">
						<label asp-for="Tipo"></label>
						<span asp-validation-for="Tipo"></span>
					</div>
					<br />
					<br />
					<div class="switch">
						Inactivo
						<label>
							<input type="checkbox">
							<span class="lever"></span>
						</label>
						Activo
					</div>
				</div>
			</div>

			<div class="row right-align">
				<button class="btn waves-effect waves-light blue lighten-1" type="submit" name="action">
					Guardar
					<i class="material-icons right">send</i>
				</button>

				<button class="btn waves-effect waves-light red lighten-1" asp-action="Index" name="action">
					Cancelar
					<i class="material-icons right">cancel</i>
				</button>
			</div>

		</form>
	</div>

</body>
</html>

<script>
	$(document).ready(function () {
		$('input#input_text, textarea#scriptSQL').characterCounter();
	});
</script>
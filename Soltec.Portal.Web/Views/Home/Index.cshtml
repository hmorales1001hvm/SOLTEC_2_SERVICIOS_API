@model IEnumerable<ApiCommon.Entities.Ventas.VentasEnLinea>
@{
    ViewData["Title"] = "Bienvenido";
}

<div class="text-center">
    <h1 class="display-4">Ventas por Cliente</h1>
</div>

<head>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta charset="UTF-8">

    <h2>Transcripción en tiempo real</h2>
    <button id="startBtn">Iniciar grabación</button>
    <button id="stopBtn" disabled>Detener grabación</button>
    <pre id="output"></pre>
</head>
<table class="responsive-table highlight z-depth-3 blue lighten-1" id="myTable">
	

	<thead class="white-text">
		<tr>
			<th class="text-center">
				Empresa
			</th>
			<th class="text-center">
				Venta
			</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr class="white accent-1">
				<td>
					@Html.DisplayFor(modelItem => item.Empresa)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Venta)
				</td>
			</tr>
		}
	</tbody>
</table>
<div class="col-md-12 center text-center">
	<span class="left" id="total_reg"></span>
	<ul class="pagination pager" id="myPager"></ul>
</div>

<script src="~/js/jquery.signalr-2.2.2.min.js"></script>
<script src="~/js/ventas/ventas.js"></script>
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<!--Import Google Icon Font-->
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/Soltec.styles.css" asp-append-version="true" />

	<!--Import materialize.css-->
	<link type="text/css" rel="stylesheet" href="~/css/materialize.min.css" media="screen,projection" />
	<script type="text/javascript" src="https://code.jquery.com/jquery-2.2.4.min.js"></script>
	<script src="~/js/pagination.js" asp-append-version="true"></script>
</head>
<body>
	<header>
		<nav>
			<div class="nav-wrapper grey darken-3">
				<a <a asp-controller="Home" asp-action="Index" class="brand-logo">Portal</a>
				<a href="#" data-target="mobile-demo" class="sidenav-trigger"><i class="material-icons">menu</i></a>
				<ul class="right hide-on-med-and-down">
					<li><a asp-controller="Script" asp-action="Index">Configuración de scripts</a></li>
				</ul>
			</div>
		</nav>

		<ul class="sidenav" id="mobile-demo">
			<li><a asp-controller="Script" asp-action="Index">Configuración de scripts</a></li>
		</ul>

	</header>

	<div id="content">
			<div class="container" style="padding-bottom: 2%;">
				<main role="main">
					@RenderBody()
				</main>
			</div>
	</div>

	<footer class="border-top footer fixed-bottom grey darken-3 text-center" style="position:fixed;bottom:0;width:100%!important;color:white!important">
			<div class="text-center">
			Derechos reservados &copy; 2024 - Soltec Consultores - <a asp-area="" asp-page="/AvisoDePrivacidad">Aviso de privacidad</a>
		</div>
	</footer>

	<script src="~/js/materialize.min.js" asp-append-version="true"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	<script>
		$(document).ready(function () {
			$('.sidenav').sidenav();
		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
